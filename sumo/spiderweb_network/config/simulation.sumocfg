<configuration>
    <input>
        <net-file value="../network/network.net.xml" />
        <route-files value="routes.rou.xml" />
        <additional-files value="additional.add.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="120" />
    </time>
    <processing>
        <collision.action value="warn" />
        <time-to-teleport value="-1" />
    </processing>
    <report>
        <verbose value="true" />
    </report>
</configuration>
